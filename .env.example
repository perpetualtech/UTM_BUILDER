# Variables de entorno del backend (Drupal) — UTP · Constructor de Nomenclaturas.
#
# Copiar a `.env` (nunca versionado, ver .gitignore) y completar valores reales.
# Leído por settings.env.php, que debe incluirse desde sites/default/settings.php.
# Si el hosting ya inyecta estas variables (Docker/DDEV/Lando/Apache SetEnv/
# Kubernetes secrets), no hace falta un .env real ni instalar vlucas/phpdotenv.

# -- Base de datos ------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PREFIX=

# -- Seguridad ------------------------------------------------------------------
# Generar con: openssl rand -base64 55
DRUPAL_HASH_SALT=
# Dominios permitidos, separados por coma, como regex sin delimitadores
# (ej: ^nomenclaturas\.utp\.edu\.pe$,^.+\.ddev\.site$)
TRUSTED_HOST_PATTERNS=

# -- Configuración --------------------------------------------------------------
# Directorio de sync de config (donde vive el diccionario exportado vía drush cex)
CONFIG_SYNC_DIRECTORY=../config/sync

# -- Entorno ----------------------------------------------------------------------
# dev | staging | prod — controla logging verbose y caché en dev
APP_ENV=prod

# -- CORS -------------------------------------------------------------------------
# Vacío: el frontend se sirve same-origin (montado por AppController en
# /admin/utp/nomenclaturas). Solo completar si el frontend corre en un
# origen distinto al de Drupal.
CORS_ALLOWED_ORIGINS=

# -- Nota: frontend ---------------------------------------------------------------
# El frontend (utp_nomenclaturas/frontend/index.html) no tiene variables de
# entorno propias: AppController::app() le inyecta la URL base de la API y
# el token CSRF directo en el HTML (window.UTP_SETTINGS) al servirlo.
